     ### service callbacks
+    def _disable_gripper_verified(self, timeout=1.5):
+        """Disable the independent gripper motor and require fresh feedback."""
+        if self.effector_type != "agx_gripper":
+            return True
+        if self.gripper is None:
+            self.get_logger().error("Gripper unavailable; cannot confirm disabled")
+            return False
+        sent = time.time()
+        deadline = time.monotonic() + timeout
+        while time.monotonic() < deadline:
+            # SDK return may reflect the pre-command sample; verify a new one.
+            self.gripper.disable()
+            status = self.gripper.get_status()
+            if (status is not None and status.timestamp >= sent
+                    and 0 <= time.time() - status.timestamp <= .25
+                    and not status.driver_enable_status):
+                self.get_logger().info("Gripper disabled: fresh driver_enable_status=False")
+                return True
+            time.sleep(.025)
+        self.get_logger().error("Gripper disable not confirmed by fresh feedback")
+        return False
+
