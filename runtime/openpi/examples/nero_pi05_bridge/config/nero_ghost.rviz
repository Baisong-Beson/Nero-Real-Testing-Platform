Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 0.1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane: XY
      Reference Frame: nero_ghost/world
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /nero_ghost/robot_description
      Enabled: true
      Name: NERO Ghost
      TF Prefix: nero_ghost
      Visual Enabled: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Marker Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /nero_ghost/tcp_path
      Name: pi0.5 TCP Path
      Namespaces:
        pi05_base_approach: true
        pi05_base_pick: true
        pi05_base_position_a: true
        pi05_base_position_b: true
        pi05_base_open_gripper: true
        pi05_base_stay_still: true
      Queue Size: 10
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: nero_ghost/world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.4
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.45
      Name: Current View
      Pitch: 0.55
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1400
